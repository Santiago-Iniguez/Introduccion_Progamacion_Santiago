Algoritmo areaTriangulo()
Inicio
    // Declarar variables
    Definir base, altura, area Como Real

    // Ingresar datos
    Escribir "Ingrese base del triángulo"
    Leer base
    Escribir "Ingrese altura del triángulo"
    Leer altura

    // Calcular área
    area <- base * altura / 2

    // Mostrar resultado
    Escribir "El área es: ", area
Fin
