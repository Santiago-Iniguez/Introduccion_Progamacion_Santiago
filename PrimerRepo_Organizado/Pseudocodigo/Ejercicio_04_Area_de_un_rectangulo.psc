Algoritmo areaRectangulo
Inicio
    // Declarar variables
    Definir base, altura, area Como Real

    // Ingresar datos
    Escribir "Ingrese base del rectángulo"
    Leer base
    Escribir "Ingrese altura del rectángulo"
    Leer altura

    // Calcular área
    area <- base * altura

    // Mostrar resultado
    Escribir "El área es: ", area
Fin